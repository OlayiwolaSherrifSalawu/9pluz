---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Panel from '../components/Panel.astro';
import Arrow from '../components/Arrow.astro';
import { SITE } from '../lib/site';
import { ROLES } from '../lib/content';
---
<Base title="Careers" description="Join 99Pluz. We're hiring a Blog Writer (culture, society and trends) and a Social Media Growth & Community Specialist.">
  <PageHero eyebrow="Careers at 99Pluz" title={['Join us']} doodle="star"
    lead="Help us tell culture’s stories. If you write sharply or know how to grow a community, we’d like to hear from you." />
  <Panel tone="black" stack={false} short label="Open roles">
    <div class="wrap">
      <h2 class="display h">Now hiring</h2>
      <ul class="roles">
        {ROLES.map((r) => (
          <li class="role reveal">
            <p class="eyebrow focus">{r.focus}</p>
            <h3 class="title">{r.title}</h3>
            <p class="summary">{r.summary}</p>
            <a class="btn btn--orange" href={`mailto:${SITE.email}?subject=${encodeURIComponent('Application: ' + r.title)}`}>Apply by email <Arrow /></a>
          </li>
        ))}
      </ul>
      <p class="how">To apply, email <a href={`mailto:${SITE.email}`} class="ulink">{SITE.email}</a> with the role in the subject line and a short note about you and your work.</p>
    </div>
  </Panel>
</Base>
<style>
  .h { padding-bottom: var(--space); }
  .roles { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--space); }
  .role { display: flex; flex-direction: column; gap: 1rem; padding: var(--space); border: 1px solid var(--c-white-30); }
  .focus { color: var(--c-orange); }
  .title { font-family: var(--f-display); text-transform: uppercase; font-size: clamp(2rem, 1.5rem + 2vw, 3.25rem); line-height: .95; }
  .summary { color: var(--c-white-60); }
  .role .btn { margin-top: auto; align-self: flex-start; }
  .how { margin-top: var(--space); color: var(--c-white-60); }
</style>
