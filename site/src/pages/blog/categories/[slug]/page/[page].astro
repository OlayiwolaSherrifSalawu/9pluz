---
import BlogList from '../../../../../components/BlogList.astro';
import { posts, visibleCategories, PER_PAGE } from '../../../../../lib/site';
export function getStaticPaths() {
  return visibleCategories.flatMap((c) => {
    const last = Math.ceil(c.count / PER_PAGE);
    return Array.from({ length: Math.max(0, last - 1) }, (_, i) => ({ params: { slug: c.slug, page: String(i + 2) }, props: { cat: c } }));
  });
}
const { cat } = Astro.props;
const all = posts.filter((p) => p.categories.includes(cat.slug));
---
<BlogList all={all} page={Number(Astro.params.page)} base={`/blog/categories/${cat.slug}`} category={cat.slug} titleTag={`${cat.name} stories`} heading={cat.name} intro={cat.description} />
