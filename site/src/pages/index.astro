---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Panel from '../components/Panel.astro';
import Wordmark from '../components/Wordmark.astro';
import Doodle from '../components/Doodle.astro';
import Arrow from '../components/Arrow.astro';
import FlipCards from '../components/FlipCards.astro';
import CoverMarquee from '../components/CoverMarquee.astro';
import ImageTrail from '../components/ImageTrail.astro';
import { posts, postImage, siteImage, categoryName, formatDate } from '../lib/site';
import { TESTIMONIALS, TEAM } from '../lib/content';

const src = async (img: any, width = 600) => (await getImage({ src: img, width, format: 'webp' })).src;

const ringPosts = posts.slice(0, 12);
const ringCards = await Promise.all(ringPosts.map(async (p) => ({
  title: p.title, category: categoryName(p.categories[0]), date: formatDate(p.published),
  partner: p.partner, image: await src(postImage(p.cover)), href: `/post/${p.slug}`,
})));
const riseCards = ringCards.slice(0, 2);
const papers = await Promise.all([
  ...TESTIMONIALS.map(async (t) => ({ quote: t.quote, name: t.name, role: t.role, image: await src(siteImage(t.photo), 200) })),
  { quote: 'Releasing a single, launching a brand or planning an event? Tell us what you’re working on and we’ll build the campaign around your story.', name: 'Your project next', role: 'info@99pluz.com' },
]);
const people = await Promise.all(TEAM.map(async (m) => ({ name: m.name, role: m.role, image: await src(siteImage(m.photo), 500) })));
const marquee = posts.slice(0, 16);
---
<Base title="99Pluz" description="99Pluz is a music PR and editorial platform. We get Afrobeats artists and culture brands seen, heard and remembered through press, playlists, content and campaigns.">

  <!-- §0 Intro: white wordmark, rotating ring of story cards -->
  <Panel tone="orange" class="intro" label="Introduction">
    <div class="intro-top wrap" data-flow-zone>
      <Wordmark text="99PLUZ" tone="white" intro flow label="99Pluz">
        <span class="intro-deco" aria-hidden="true"><Doodle name="sparkle" still /></span>
      </Wordmark>
    </div>
    <div class="gl ring" data-gl="ring" data-cards={JSON.stringify(ringCards)}>
      <ul class="gl__fallback ring-fallback">
        {ringPosts.slice(0, 6).map((p) => <li><Image src={postImage(p.cover)} alt="" width={240} height={240} /></li>)}
      </ul>
    </div>
    <div class="intro-foot wrap">
      <h1 class="text-lead intro-lead">
        <span>Music PR, editorial &amp; brand strategy.</span>
        <span>For Afrobeats artists and culture brands.</span>
      </h1>
      <nav class="sr-only" aria-label="Latest stories">
        <ul>{ringPosts.map((p) => <li><a href={`/post/${p.slug}`}>{p.title}</a></li>)}</ul>
      </nav>
    </div>
  </Panel>

  <!-- §1 Get heard -->
  <Panel tone="green" label="Get heard">
    <div class="wrap split s1">
      <div class="s1-media">
        <a href="/music-pr" class="media-card reveal" aria-label="Explore Music PR">
          <span class="brush-circle" aria-hidden="true"></span>
          <Image src={siteImage('music-pr.jpg')} alt="An artist in white sunglasses holding headphones toward the camera" width={800} widths={[480, 800]} sizes="(min-width: 668px) 40vw, 90vw" class="media-img" />
          <span class="play" aria-hidden="true"><span class="play-accent"></span><Arrow circled={false} /></span>
        </a>
      </div>
      <div class="s1-copy">
        <h2 class="display s1-title">
          <span class="mega-reveal" data-reveal><span>Get</span></span>
          <span class="mega-reveal" data-reveal><span>heard<Doodle name="sparkle" class="s1-sparkle" /></span></span>
        </h2>
        <div class="rule-top s1-body reveal">
          <p class="text-base">In a world full of noise, we make sure your story cuts through. 99Pluz is where music, media and culture meet visibility:</p>
          <ul class="hyphens text-base">
            <li>editorial features and interviews</li>
            <li>playlist outreach and chart campaigns</li>
            <li>content and on-ground event coverage</li>
            <li>brand strategy for culture brands</li>
          </ul>
          <a href="/music-pr" class="btn btn--solid">Explore Music PR <Arrow /></a>
        </div>
      </div>
    </div>
  </Panel>

  <!-- §2 The blog: cards rise through the letters -->
  <Panel tone="pink" label="The blog" hold={0.5}>
    <div class="s2-stage" data-flow-zone>
      <div class="wrap s2-word"><Wordmark text="The blog" as="h2" /></div>
      <div class="gl s2-gl" data-gl="rise" data-cards={JSON.stringify(riseCards)}>
        <div class="gl__fallback s2-fallback">
          {posts.slice(0, 2).map((p) => <Image src={postImage(p.cover)} alt="" width={320} height={320} />)}
        </div>
      </div>
      <div class="wrap s2-word s2-word--front" aria-hidden="true"><Wordmark text="The blog" /></div>
    </div>
    <div class="wrap split rule-top s2-cols">
      <p class="text-base reveal">Afrobeats news, culture and music PR insights. Explainers for when the timeline gets loud.</p>
      <div class="reveal s2-right">
        <p class="text-base">{posts.length} stories on new music, the industry behind it and the conversations shaping Nigeria and the diaspora. Client stories are always labelled.</p>
        <a href="/blog" class="btn btn--solid">Read the blog <Arrow /></a>
      </div>
    </div>
  </Panel>

  <!-- §3 Services: flip cards on an orange brush X -->
  <Panel tone="green" label="Services">
    <div class="wrap split s3">
      <div class="s3-left">
        <h2 class="display s3-title">
          <span class="mega-reveal" data-reveal><span>Serv</span></span>
          <span class="mega-reveal" data-reveal><span>ices<Doodle name="scribble-star" class="s3-star" /></span></span>
        </h2>
        <p class="text-base reveal s3-copy">Stop juggling five different agencies. One team handles your <span class="uwipe">press, playlists and campaigns<span class="uwipe__line" aria-hidden="true"></span></span>, so your story lands the same way everywhere.</p>
        <div class="btn-row reveal">
          <a href="/music-pr" class="btn btn--solid">Music PR <Arrow /></a>
          <a href="/brand-strategy" class="btn btn--ghost">Brand strategy</a>
        </div>
      </div>
      <div class="s3-right">
        <span class="brush-x" aria-hidden="true"></span>
        <FlipCards items={[
          { label: 'Press & media features', text: 'Interviews, articles and coverage that build credibility and introduce your music to a wider audience.', href: '/music-pr' },
          { label: 'Editorial playlist placement', text: 'We pitch your tracks to curated playlists, including our own, to grow streams and engagement.', href: '/music-pr' },
          { label: 'Brand & creative strategy', text: 'Identity, rebrands and campaigns that make brands feel right to the people they serve.', href: '/brand-strategy' },
          { label: 'Event coverage & content', text: 'Red-carpet interviews, highlight reels and social-ready edits that make the moment last.', href: '/brand-strategy' },
        ]} />
      </div>
    </div>
  </Panel>

  <!-- §4 Fact first: marquee of covers -->
  <Panel tone="pink" label="Editorial standards">
    <div class="wrap s4">
      <h2 class="display s4-title">
        <span class="mega-reveal" data-reveal><span>Fact</span></span>
        <span class="mega-reveal" data-reveal><span>first<Doodle name="note" class="s4-note" /></span></span>
      </h2>
      <p class="text-small s4-caption reveal">Every story is written to explain what happened, why it matters and what people are missing.</p>
      <div class="s4-body reveal">
        <p class="text-base">Clear sourcing, plain language and no sensationalism. Paid campaigns and sponsored stories are labelled, and they never decide our reviews.</p>
        <a href="/about#editorial-standards" class="btn btn--ghost">Our editorial standards <Arrow /></a>
      </div>
    </div>
    <div class="s4-loop"><CoverMarquee posts={marquee} label="Recent stories" /></div>
  </Panel>

  <!-- §5 Testimonials: curling paper cards -->
  <Panel tone="blue" label="Testimonials">
    <div data-papers-root tabindex="-1">
      <div class="wrap s5-word">
        <Wordmark text="Testimonials" as="h2">
          <span class="s5-oval" aria-hidden="true"><Doodle name="oval" /></span>
        </Wordmark>
      </div>
      <div class="gl s5-gl" data-gl="papers" data-papers={JSON.stringify(papers)}>
        <div class="gl__fallback wrap s5-fallback">
          {TESTIMONIALS.map((t) => <blockquote class="paper"><p>“{t.quote}”</p><footer>{t.name}, {t.role}</footer></blockquote>)}
        </div>
      </div>
      <div class="wrap s5-controls">
        <button type="button" class="txt-btn" data-prev><span class="icon-tick icon-tick--rev" aria-hidden="true">‹</span> Prev</button>
        <span class="text-small" data-count aria-hidden="true">01 / 03</span>
        <button type="button" class="txt-btn" data-next>Next <span class="icon-tick" aria-hidden="true">›</span></button>
      </div>
      <div class="sr-only">
        {TESTIMONIALS.map((t) => <blockquote><p>{t.quote}</p><footer>{t.name}, {t.role}</footer></blockquote>)}
      </div>
      <p class="sr-only" aria-live="polite" data-live></p>
    </div>
  </Panel>

  <!-- §6 The people: tilted team screen rises behind the letters -->
  <Panel tone="green" label="Team">
    <div class="wrap s6-head">
      <p class="text-small">The people behind the work</p>
    </div>
    <div class="s6-stage">
      <div class="gl s6-gl" data-gl="screen" data-people={JSON.stringify(people)}>
        <div class="gl__fallback wrap s6-fallback">
          {TEAM.map((m) => <figure><Image src={siteImage(m.photo)} alt={`Portrait of ${m.name}`} width={300} height={360} /><figcaption>{m.name}</figcaption></figure>)}
        </div>
      </div>
      <div class="wrap s6-word">
        <span class="script s6-the" aria-hidden="true">the</span>
        <Wordmark text="Newsroom" as="h2" label="The newsroom" />
      </div>
    </div>
    <div class="wrap split rule-top s6-cols">
      <p class="text-base reveal">A culture-first PR agency and editorial platform.</p>
      <div class="reveal s6-right">
        <p class="text-base">{TEAM.map((m) => m.name.split(' ')[0]).join(', ').replace(/, ([^,]*)$/, ' and $1')} lead campaigns, editorial and content. Culture is built, not broadcast, and our work starts with listening.</p>
        <a href="/about#team" class="btn btn--solid">Meet the team <Arrow /></a>
      </div>
    </div>
  </Panel>

  <!-- §7 Let's talk: vertical giant word + image trail -->
  <Panel tone="orange" label="Work with us" class="s7">
    <div class="wrap split s7-grid">
      <ImageTrail class="s7-trail">
        <h2 class="s7-word" aria-label="Let's talk">
          <span class="script s7-lets" aria-hidden="true">Let’s</span>
          {'TALK'.split('').map((c) => <span class="s7-ch mega-reveal" data-reveal aria-hidden="true"><span>{c}</span></span>)}
        </h2>
      </ImageTrail>
      <div class="s7-right">
        <p class="text-lead reveal">Releasing a single, building a brand or planning a campaign? Tell us what you’re working on.</p>
        <p class="text-base reveal"><a href="mailto:info@99pluz.com" class="ulink">info@99pluz.com</a> · <a href="tel:+447303170351" class="ulink">+44 7303 170351</a></p>
        <Doodle name="arrow" class="s7-arrow" />
      </div>
    </div>
  </Panel>
</Base>

<style>
  /* §0 */
  .intro { display: flex; flex-direction: column; height: 100svh; min-height: 560px; padding-bottom: var(--spacing); overflow: clip; }
  .intro-top { position: relative; z-index: 2; }
  .intro-deco { position: absolute; right: 1%; top: 58%; width: 8%; color: #fff; transform: translateY(300%) rotate(35deg); transition: transform var(--dur-hero) var(--ease-heavy) 1s; }
  :global(.intro--show) .intro-deco { transform: none; }
  .ring { position: absolute; inset: 36% 0 0 0; z-index: 1; transform: translateY(100%) rotate(35deg); transform-origin: 100% 100%; transition: transform var(--dur-hero) var(--ease-heavy) 1s; }
  :global(.intro--show) .ring, :global(.no-js) .ring { transform: none; }
  :global(.gl--fallback) .ring-fallback { display: flex; }
  .ring-fallback { list-style: none; gap: 12px; justify-content: center; padding-top: 10%; }
  .ring-fallback li { width: 14vw; rotate: -6deg; }
  .intro-foot { position: relative; z-index: 3; margin-top: auto; pointer-events: none; transform: translateY(150%); transition: transform var(--dur-hero) var(--ease-heavy); }
  :global(.intro--show) .intro-foot, :global(.no-js) .intro-foot { transform: none; }
  .intro-lead { display: grid; max-width: 16em; color: #fff; font-weight: 350; }
  @media (max-width: 667px) { .ring { inset: 30% -20% 8% -20%; } .intro-deco { width: 14%; } }

  /* §1 */
  .s1 { min-height: calc(100svh - var(--header-h) - var(--R) * 10); align-items: stretch; }
  .s1-media { display: grid; place-items: center; padding: calc(var(--R) * 4); }
  .media-card { position: relative; display: block; width: min(100%, 46rem); rotate: -4deg; }
  .brush-circle { position: absolute; inset: -18% -16%; background: url('/brush-circle.svg') center / contain no-repeat; z-index: -1; }
  .media-img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .play { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: calc(var(--R) * 7); height: calc(var(--R) * 7); display: grid; place-items: center; background: #fff; color: #000; border-radius: 50%; isolation: isolate; }
  .play-accent { position: absolute; left: -40%; right: -40%; top: 50%; height: 60%; background: url('/brush-stroke.svg') center / 100% 100% no-repeat; z-index: -1; opacity: 0; transform: translateY(-50%) scaleX(.5); transition: opacity var(--dur-hover) var(--ease-snappy), transform var(--dur-hover) var(--ease-snappy); }
  .media-card:hover .play-accent { opacity: 1; transform: translateY(-50%) scaleX(1); }
  .s1-copy { display: flex; flex-direction: column; justify-content: space-between; gap: var(--space); padding-left: var(--spacing); }
  .s1-title { position: relative; }
  .s1-title :global(.s1-sparkle) { display: inline-block; width: .42em; vertical-align: top; margin-left: -.12em; margin-top: -.1em; color: #fff; }
  .s1-body { display: grid; gap: calc(var(--R) * 2.4); padding-top: var(--spacing); justify-items: start; }
  .hyphens { list-style: none; }
  .hyphens li::before { content: '– '; }
  @media (max-width: 667px) { .s1-copy { padding-left: 0; } }

  /* §2 */
  .s2-stage { position: relative; }
  .s2-gl { position: absolute; inset: -40% 0 -60% 0; z-index: 2; pointer-events: none; }
  .s2-word { position: relative; z-index: 1; }
  .s2-word--front { position: absolute; inset: 0; z-index: 3; clip-path: inset(0 50% 0 0); pointer-events: none; }
  .s2-fallback { display: none; }
  .s2-cols { position: relative; z-index: 4; margin-top: calc(var(--R) * 16); }
  .s2-cols > * { padding-block: var(--spacing); }
  .s2-right { display: grid; gap: calc(var(--R) * 2.4); justify-items: start; }
  @media (min-width: 668px) { .s2-right { padding-left: var(--spacing); } }

  /* §3 */
  .s3 { min-height: calc(100svh - var(--header-h) - var(--R) * 10); }
  .s3-left { display: flex; flex-direction: column; gap: var(--space); padding-right: var(--spacing); }
  .s3-title :global(.s3-star) { display: inline-block; width: .5em; vertical-align: top; margin-left: .05em; color: #fff; }
  .s3-copy { max-width: 26em; margin-top: auto; }
  .s3-right { position: relative; display: grid; place-items: center; padding: calc(var(--R) * 4) calc(var(--R) * 4) calc(var(--R) * 4) calc(var(--spacing) + var(--R) * 4); }
  .s3-right :global(.flips) { width: min(100%, 30rem); }
  .brush-x { position: absolute; inset: -2% 4%; background: url('/brush-x.svg') center / contain no-repeat; }
  @media (max-width: 667px) { .s3-right { padding: var(--space) 0; } .s3-left { padding-right: 0; } }

  /* §4 */
  .s4 { display: grid; gap: var(--space); grid-template-columns: 1fr; }
  @media (min-width: 668px) { .s4 { grid-template-columns: 1fr 1fr; grid-template-rows: auto 1fr; } }
  .s4-title { grid-row: span 2; }
  .s4-title :global(.s4-note) { display: inline-block; width: .42em; vertical-align: top; margin-left: .05em; margin-top: -.2em; color: #fff; }
  .s4-caption { justify-self: end; text-align: right; max-width: 22em; }
  .s4-body { align-self: end; display: grid; gap: calc(var(--R) * 2.4); justify-items: start; max-width: 28em; }
  .s4-loop { margin-top: calc(var(--R) * 6); }

  /* §5 */
  .s5-word { position: relative; z-index: 1; }
  .s5-oval { position: absolute; left: 48.6%; top: -16%; width: 11%; color: #fff; }
  .s5-gl { position: relative; z-index: 2; height: min(68vh, 52vw); margin-top: calc(var(--R) * -10); }
  @media (max-width: 667px) { .s5-gl { height: 56vh; margin-top: 0; } }
  .s5-fallback { display: none; }
  .gl--fallback.s5-gl { height: auto; margin-top: var(--space); }
  .gl--fallback .s5-fallback { display: grid; gap: var(--spacing); grid-template-columns: repeat(auto-fit, minmax(min(100%, 32rem), 1fr)); }
  .paper { margin: 0; background: #fff; color: #000; padding: calc(var(--R) * 3); display: grid; gap: 1rem; }
  .s5-controls { position: relative; z-index: 3; display: flex; align-items: center; gap: calc(var(--R) * 3); }
  @media (min-width: 668px) { .s5-controls { padding-left: 18%; } }
  .txt-btn { background: none; border: 0; padding: .6rem 0; cursor: pointer; font-size: calc(var(--R) * 2); display: inline-flex; gap: .4em; align-items: center; }
  .txt-btn .icon-tick { display: inline-block; font-size: 1.3em; line-height: 1; }
  .txt-btn:hover { text-decoration: underline; text-underline-offset: 4px; }

  /* §6 */
  .s6-head { padding-bottom: calc(var(--R) * 2); }
  .s6-stage { position: relative; }
  .s6-gl { position: absolute; inset: 10% 0 -95% 0; z-index: 1; pointer-events: none; }
  .s6-word { position: relative; z-index: 2; }
  .s6-the { position: absolute; left: calc(var(--spacing) - .1em); top: -.35em; font-size: min(calc(var(--R) * 14), 15vw); line-height: 1; z-index: 3; rotate: -8deg; }
  .s6-fallback { display: none; }
  .gl--fallback.s6-gl { position: relative; inset: auto; }
  .gl--fallback .s6-fallback { display: flex; gap: var(--spacing); }
  .s6-cols { position: relative; z-index: 3; margin-top: min(30vw, 40vh); }
  .s6-cols > * { padding-block: var(--spacing); }
  .s6-right { display: grid; gap: calc(var(--R) * 2.4); justify-items: start; }
  @media (min-width: 668px) { .s6-right { padding-left: var(--spacing); } }

  /* §7 */
  .s7 { min-height: 100svh; }
  .s7-grid { min-height: calc(100svh - var(--header-h) - var(--R) * 12); }
  .s7-grid > * + * { border-left: 0; }
  .s7-trail :global(.photo) { z-index: 0; }
  .s7-word { position: relative; display: grid; font-family: var(--f-display); text-transform: uppercase; color: #000; font-size: min(32vh, 30vw); line-height: .8; }
  .s7-ch { width: fit-content; }
  .s7-lets { position: absolute; left: .62em; top: .45em; font-size: .3em; rotate: -10deg; z-index: 2; }
  .s7-right { position: relative; display: flex; flex-direction: column; justify-content: center; gap: var(--space); padding-block: var(--space); }
  .s7-right :global(.s7-arrow) { width: calc(var(--R) * 18); color: #000; align-self: flex-end; margin-right: 8%; transform: rotate(28deg); }
  @media (min-width: 668px) { .s7-right { padding-left: var(--spacing); } }
</style>
