---
// Original hand-drawn marks. They draw in when they scroll into view (see motion.ts).
import { DOODLES, type DoodleName } from '../lib/doodles';
interface Props { name: DoodleName; class?: string; width?: number; stretch?: boolean; still?: boolean }
const { name, class: cls = '', width, stretch = false, still = false } = Astro.props;
const s = DOODLES[name];
---
<svg class={`doodle doodle--${name} ${still ? 'doodle--still' : ''} ${cls}`} viewBox={s.vb} width={width} aria-hidden="true" focusable="false" fill="none" preserveAspectRatio={stretch ? 'none' : undefined}>
  {s.d.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}
</svg>
<style>
  .doodle { pointer-events: none; overflow: visible; }
  .doodle path {
    stroke: currentColor; stroke-width: 5; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 1; stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.1s var(--ease-heavy) calc(var(--i) * .18s + .3s);
  }
  .doodle--still path { stroke-dasharray: none; stroke-dashoffset: 0; transition: none; }
  :global(.is-in) .doodle path, .doodle:global(.is-in) path { stroke-dashoffset: 0; }
  :global(.no-js) .doodle path { stroke-dashoffset: 0; }
  @media (prefers-reduced-motion: reduce) { .doodle path { stroke-dashoffset: 0; } }
</style>
