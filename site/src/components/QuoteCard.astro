---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { quote: string; name: string; role: string; photo: ImageMetadata }
const { quote, name, role, photo } = Astro.props;
---
<figure class="quote">
  <blockquote><p>“{quote}”</p></blockquote>
  <figcaption>
    <Image src={photo} alt={`${name}`} width={96} height={96} class="photo" />
    <span><strong>{name}</strong><br /><span class="muted">{role}</span></span>
  </figcaption>
</figure>
<style>
  .quote { margin: 0; display: flex; flex-direction: column; justify-content: space-between; gap: var(--space); padding: var(--space); background: var(--c-ink); color: var(--c-white); border: 1px solid var(--c-white-30); height: 100%; }
  blockquote { margin: 0; font-size: clamp(1.125rem, 1rem + .5vw, 1.5rem); line-height: 1.4; text-wrap: pretty; }
  figcaption { display: flex; align-items: center; gap: 1rem; font-size: var(--fs-s); }
  .photo { width: 4rem; height: 4rem; object-fit: cover; object-position: top; filter: grayscale(1); }
  .muted { color: var(--c-white-60); }
</style>
