---
// Image trail (spec §6.4 §7): photos pop out along the cursor path; older ones shrink to .45 and fade.
// When the pointer leaves, they settle into a fixed collage.
import { getImage } from 'astro:assets';
import { posts, postImage } from '../lib/site';
interface Props { count?: number; class?: string }
const { count = 10, class: cls = '' } = Astro.props;
const imgs = await Promise.all(posts.slice(0, count).map((p) => getImage({ src: postImage(p.cover), width: 320, format: 'webp' })));
const rest = [[31.1, 36.9, .5625], [47.4, 50.3, .625], [62, 30, .5], [24, 62, .55], [56, 70, .6], [72, 56, .52], [40, 22, .48], [80, 26, .5], [18, 30, .45], [66, 82, .5]];
---
<div class={`trail ${cls}`} data-trail>
  {imgs.map((im, i) => {
    const [x, y, s] = rest[i % rest.length];
    return <img class="photo" src={im.src} alt="" loading="lazy" decoding="async" style={`--rx:${x}%;--ry:${y}%;--rs:${s};z-index:${i}`} />;
  })}
  <slot />
</div>
<style>
  .trail { position: relative; }
  .photo {
    position: absolute; left: var(--rx); top: var(--ry); width: 10.96vw; aspect-ratio: 1; object-fit: cover; pointer-events: none;
    translate: -50% -50%; scale: var(--s, var(--rs)); opacity: var(--o, 1);
    transition: scale var(--dur-ui), opacity var(--dur-ui), left .9s var(--ease-heavy), top .9s var(--ease-heavy);
  }
  .trail.is-active .photo { transition: scale var(--dur-ui), opacity var(--dur-ui); }
  @media (max-width: 667px) { .photo { width: 28.2vw; } }
  .trail > :global(*:not(.photo)) { position: relative; z-index: 20; }
</style>
<script>
  const fine = matchMedia('(pointer: fine)').matches;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-trail]').forEach((el) => {
    const photos = [...el.querySelectorAll<HTMLImageElement>('.photo')];
    if (!fine || reduce) return;
    let n = 0, lx = -999, ly = -999, z = photos.length;
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      const x = e.clientX - r.left, y = e.clientY - r.top;
      if (Math.hypot(x - lx, y - ly) < 70) return;
      lx = x; ly = y;
      el.classList.add('is-active');
      const p = photos[n++ % photos.length];
      photos.forEach((q) => { if (q !== p) { q.style.setProperty('--s', '.4545'); q.style.setProperty('--o', '0'); } });
      p.style.left = `${x}px`; p.style.top = `${y}px`;
      p.style.setProperty('--s', '1'); p.style.setProperty('--o', '1');
      p.style.zIndex = String(++z);
    });
    el.addEventListener('pointerleave', () => {
      el.classList.remove('is-active');
      photos.forEach((p) => { p.style.removeProperty('--s'); p.style.removeProperty('--o'); p.style.left = ''; p.style.top = ''; });
    });
  });
</script>
