---
import { NAV, SITE } from '../lib/site';
const path = Astro.url.pathname.replace(/\.html$/, '');
const isActive = (href: string) => path === href || path.startsWith(href + '/') || (href === '/blog' && path.startsWith('/post/'));
const nav = NAV.filter((n) => n.href !== '/contact');
---
<header class="site-header" data-header>
  <div class="bg" aria-hidden="true"></div>
  <div class="bar">
    <a href="/" class="brand" aria-label="99Pluz home">
      <span class="brand-name">99 PLUZ</span>
      <span class="brand-tag">{SITE.tagline}</span>
    </a>
    <nav class="nav" aria-label="Main">
      <ul>
        {nav.map((n) => <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="right">
      <a href="/contact" class="link" aria-current={isActive('/contact') ? 'page' : undefined}>Contact</a>
      <a href="/contact" class="link link--strong">Work with us</a>
    </div>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="menu-label">Menu</span>
    </button>
  </div>
  <div class="mobile-menu ui-orange" id="mobile-menu" hidden>
    <nav aria-label="Mobile">
      <ul>
        {NAV.map((n) => <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="mobile-contact">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <a href={SITE.phoneHref}>{SITE.phone}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    --hbg: var(--c-orange);
    position: fixed; inset: 0 0 auto 0; z-index: 50; color: #fff;
    font-size: calc(var(--R) * 1.2); line-height: calc(var(--R) * 1.6);
    transform: translateY(0); opacity: 1;
    transition: opacity var(--dur-hero) var(--ease-heavy), transform var(--dur-hero) var(--ease-heavy);
  }
  @media (min-width: 668px) { .site-header { font-size: calc(var(--R) * 1.3); } }
  :global(html.is-loading) .site-header { opacity: 0; transform: translateY(-200%); }
  .bg { position: absolute; inset: 0; background: var(--hbg); transition: background-color var(--dur-ui) var(--ease-snappy); }
  .bar { position: relative; height: var(--header-h); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; padding-inline: var(--spacing); }
  /* hairline draws in from the left */
  .bar::after { content: ''; position: absolute; left: var(--spacing); right: var(--spacing); bottom: 0; height: 1px; background: var(--c-white-30); transform: scaleX(1); transform-origin: left; transition: transform var(--dur-hero) var(--ease-heavy) .3s; }
  :global(html.is-loading) .bar::after, :global(html:not(.intro--show)) .bar::after { transform: scaleX(0); }
  :global(html.no-js) .bar::after { transform: scaleX(1); }
  .brand { display: grid; text-decoration: none; justify-self: start; }
  .brand-name { letter-spacing: .02em; }
  .brand-tag { color: var(--c-white-60); }
  .nav ul { display: flex; gap: calc(var(--R) * 3); list-style: none; }
  .nav a, .link { text-decoration: none; position: relative; padding-block: .4rem; }
  .nav a::after, .link::after { content: ''; position: absolute; left: 0; right: 0; bottom: .15rem; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform var(--dur-ui) var(--ease-heavy); }
  .nav a:hover::after, .link:hover::after, [aria-current='page']::after { transform: scaleX(1); transform-origin: left; }
  .right { display: flex; gap: calc(var(--R) * 3); justify-self: end; }
  .menu-btn { display: none; justify-self: end; background: none; border: 0; padding: .5rem 0; cursor: pointer; }
  .menu-label { position: relative; }
  .mobile-menu { position: fixed; inset: var(--header-h) 0 0 0; padding: var(--spacing); display: flex; flex-direction: column; justify-content: space-between; overflow-y: auto; }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu ul { list-style: none; }
  .mobile-menu li + li { border-top: 1px solid var(--c-white-30); }
  .mobile-menu nav a { display: block; font-family: var(--f-display); text-transform: uppercase; color: #000; font-size: clamp(44px, 15vw, 70px); line-height: 1.05; padding-block: .3rem; text-decoration: none; }
  .mobile-contact { display: grid; gap: .5rem; padding-top: 2rem; font-size: 16px; }
  @media (max-width: 979px) {
    .bar { grid-template-columns: 1fr auto; }
    .nav, .right { display: none; }
    .menu-btn { display: block; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const label = btn.querySelector('.menu-label')!;
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close' : 'Menu';
      menu.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
      (window as any).__lenis?.[open ? 'stop' : 'start']();
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
    matchMedia('(min-width: 980px)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>
