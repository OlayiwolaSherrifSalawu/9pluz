---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Doodle from './Doodle.astro';
interface Props { eyebrow: string; title: string[]; lead: string; image?: ImageMetadata; imageAlt?: string; doodle?: 'star' | 'underline' | 'loop' | 'swoosh' | 'burst' }
const { eyebrow, title, lead, image, imageAlt = '', doodle = 'star' } = Astro.props;
---
<section class="page-hero panel panel--orange on-orange" data-stack>
  <div class="wrap grid">
    <div class="text">
      <p class="eyebrow reveal">{eyebrow}</p>
      <h1 class="mega title">
        {title.map((l) => <span class="mega-reveal" data-reveal><span>{l}</span></span>)}
        <Doodle name={doodle} class={`ph-doodle ph-doodle--${doodle}`} />
      </h1>
      <p class="lead reveal">{lead}</p>
      <div class="reveal"><slot name="actions" /></div>
    </div>
    {image && <Image src={image} alt={imageAlt} width={900} widths={[480, 720, 900]} sizes="(min-width: 900px) 40vw, 92vw" loading="eager" class="hero-img reveal" />}
  </div>
</section>
<style>
  .page-hero { min-height: auto; padding-bottom: var(--space-l); }
  .grid { display: grid; gap: var(--space); align-items: end; }
  @media (min-width: 900px) { .grid:has(.hero-img) { grid-template-columns: 1.4fr 1fr; } }
  .text { display: grid; gap: var(--space); }
  .title { position: relative; width: fit-content; font-size: clamp(4rem, 2rem + 11vw, 14rem); }
  .title :global(.ph-doodle) { position: absolute; color: var(--c-white); }
  .title :global(.ph-doodle--star) { width: .34em; right: -.42em; top: -.08em; }
  .title :global(.ph-doodle--underline), .title :global(.ph-doodle--swoosh) { width: 80%; left: 0; bottom: -.22em; }
  .title :global(.ph-doodle--loop) { width: 115%; left: -6%; bottom: -.12em; }
  .title :global(.ph-doodle--burst) { width: .45em; right: -.5em; top: -.2em; }
  .hero-img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border: 1px solid var(--c-ink); }
</style>
