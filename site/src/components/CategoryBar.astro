---
import { visibleCategories } from '../lib/site';
interface Props { active?: string }
const { active = 'all' } = Astro.props;
---
<nav class="catbar" aria-label="Blog categories">
  <ul class="wrap">
    <li><a href="/blog" aria-current={active === 'all' ? 'page' : undefined}>All posts</a></li>
    {visibleCategories.map((c) => (
      <li><a href={`/blog/categories/${c.slug}`} aria-current={active === c.slug ? 'page' : undefined}>{c.name}</a></li>
    ))}
  </ul>
</nav>
<style>
  .catbar { position: sticky; top: var(--header-h); z-index: 20; background: var(--c-green); color: #fff; border-bottom: 1px solid var(--c-white-30); }
  ul { display: flex; gap: calc(var(--R) * 2.4); list-style: none; overflow-x: auto; scrollbar-width: none; padding-block: calc(var(--R) * 1.2); }
  ul::-webkit-scrollbar { display: none; }
  a { position: relative; display: block; white-space: nowrap; padding-block: .3rem; font-size: calc(var(--R) * 1.6); text-decoration: none; }
  a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: #000; transform: scaleX(0); transform-origin: right; transition: transform var(--dur-ui) var(--ease-heavy); }
  a:hover::after, a[aria-current='page']::after { transform: scaleX(1); transform-origin: left; }
  a[aria-current='page'] { color: #000; }
</style>
