---
interface Props { current: number; last: number; base: string }
const { current, last, base } = Astro.props;
const href = (n: number) => (n === 1 ? base : `${base}/page/${n}`);
const pages = Array.from({ length: last }, (_, i) => i + 1).filter((n) => n === 1 || n === last || Math.abs(n - current) <= 2);
---
{last > 1 && (
  <nav class="pager" aria-label="Pagination">
    {current > 1 ? <a class="btn btn--ghost" href={href(current - 1)} rel="prev">Newer</a> : <span />}
    <ol>
      {pages.map((n, i) => (
        <>
          {i > 0 && n - pages[i - 1] > 1 && <li aria-hidden="true">…</li>}
          <li><a href={href(n)} aria-current={n === current ? 'page' : undefined} aria-label={`Page ${n}`}>{n}</a></li>
        </>
      ))}
    </ol>
    {current < last ? <a class="btn btn--ghost" href={href(current + 1)} rel="next">Older</a> : <span />}
  </nav>
)}
<style>
  .pager { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: calc(var(--R) * 3); margin-top: calc(var(--R) * 5); border-top: 1px solid var(--t-line); font-size: calc(var(--R) * 1.6); }
  ol { display: flex; flex-wrap: wrap; justify-content: center; gap: .25rem; list-style: none; padding: 0; margin: 0; }
  ol a { display: grid; place-items: center; min-width: 2.75rem; height: 2.75rem; text-decoration: none; }
  ol a:hover { text-decoration: underline; }
  ol a[aria-current='page'] { background: #000; color: #fff; }
  li[aria-hidden] { display: grid; place-items: center; min-width: 1.5rem; }
  @media (max-width: 560px) { ol { display: none; } }
</style>
