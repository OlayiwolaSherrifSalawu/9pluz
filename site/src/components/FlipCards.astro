---
// 2×2 black cards that flip on the Y axis to their description (spec §6.4 §3). Tap/focus also flips.
interface Props { items: { label: string; text: string; extra?: string; href?: string }[]; grid?: boolean }
const { items, grid = false } = Astro.props;
---
<ul class={`flips ${grid ? 'flips--grid' : ''}`} style={grid ? `--cols:${items.length <= 5 ? items.length : Math.ceil(items.length / 2)}` : undefined}>
  {items.map((it, i) => (
    <li class="flip reveal" tabindex="0" data-flip>
      <div class="inner">
        <div class="face front">
          <span class="num">{i + 1}</span>
          <span class="label">{it.label}</span>
        </div>
        <div class="face back">
          <div class="back-text"><p>{it.text}</p>{it.extra && <p class="extra">{it.extra}</p>}</div>
          {it.href ? <a href={it.href} class="more" tabindex="-1">Learn more →</a> : <span />}
        </div>
      </div>
    </li>
  ))}
</ul>
<style>
  .flips { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: calc(var(--R) * 1); position: relative; z-index: 1; }
  .flips--grid { grid-template-columns: 1fr; }
  @media (min-width: 568px) { .flips--grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 980px) { .flips--grid { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); } }
  .flip { perspective: 1200px; aspect-ratio: 159 / 187; outline-offset: 4px; }
  .flips--grid .flip { aspect-ratio: 1; }
  @media (min-width: 568px) { .flips--grid .flip { aspect-ratio: 3 / 4; } }
  @media (min-width: 980px) { .flips--grid[style*='--cols:3'] .flip { aspect-ratio: 16 / 10; } }
  .inner { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform var(--dur-flip) var(--ease-heavy); will-change: transform; }
  .flip:hover .inner, .flip:focus-visible .inner, .flip.is-flipped .inner { transform: rotateY(180deg); }
  .face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; background: #000; color: #fff; display: flex; flex-direction: column; justify-content: space-between; padding: calc(var(--R) * 1.4); }
  .back { transform: rotateY(180deg); }
  .num { font-size: calc(var(--R) * 1.6); }
  .label { font-size: calc(var(--R) * 1.6); line-height: calc(var(--R) * 2); }
  .back-text { display: grid; gap: .8em; }
  .back p { font-size: calc(var(--R) * 1.4); line-height: calc(var(--R) * 1.8); }
  .back .extra { color: var(--c-white-60); }
  .flips--grid .label { font-family: var(--f-display); text-transform: uppercase; font-size: calc(var(--R) * 2.8); line-height: .95; letter-spacing: 0; }
  @media (min-width: 980px) { .flips--grid .label { font-size: calc(var(--R) * 3.6); } }
  .more { font-size: calc(var(--R) * 1.3); text-decoration: none; color: var(--c-orange); }
  @media (min-width: 668px) {
    .label { font-size: calc(var(--R) * 2); line-height: calc(var(--R) * 2.5); }
    .back p { font-size: calc(var(--R) * 1.6); line-height: calc(var(--R) * 2); }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-flip]').forEach((c) => {
    c.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('a')) c.classList.toggle('is-flipped'); });
    c.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); c.classList.toggle('is-flipped'); } });
    c.addEventListener('focusin', () => c.querySelector('a')?.setAttribute('tabindex', '0'));
  });
</script>
